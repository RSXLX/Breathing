{
  "name": "breathe-city",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Animate original objects in photos and fixed-camera video",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node tools/build-app-shell.mjs && node tools/build.mjs",
    "check": "node tools/check.mjs",
    "verify": "npm run check && npm test && npm run build",
    "test:browser": "node tests/studio-browser.mjs",
    "test:video": "node tests/video-browser.mjs",
    "test:cloud": "node tests/cloud-browser.mjs",
    "native:sync": "npm run build && node tools/build-native.mjs && cap sync",
    "native:ios": "cap open ios",
    "native:android": "cap open android",
    "test:app": "node tests/app-browser.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/camera": "8.2.4",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.2",
    "@capacitor/share": "8.0.2",
    "@ionic/core": "9.0.4",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
