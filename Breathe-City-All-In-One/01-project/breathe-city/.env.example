# Copy to .env. Local demo works WITHOUT this file or any key.
PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3000
# Needed for paid APIs or a non-loopback bind. Use at least 24 random characters.
ADMIN_TOKEN=
ALLOW_PAID_APIS=false
TRIPO_API_KEY=
TRIPO_MODEL=v3.1-20260211
WORLDLABS_API_KEY=
WORLDLABS_MODEL=marble-1.1
DECART_API_KEY=
DECART_MODEL=lucy-2.5
# Browser import URL: pin to a tested SDK version before a public release.
DECART_SDK_URL=https://esm.sh/@decartai/sdk
MAX_REAL_JOBS_PER_DAY=10
MAX_REALTIME_TOKENS_PER_DAY=20
MAX_SESSION_SECONDS=30
DATA_DIR=./data

# v0.2 video generation. Disabled until account, price and budget are verified.
VIDEO_GENERATION_ENABLED=false
RUNWAY_API_KEY=
VIDEO_MODEL=gen4.5
# SHA256 of a private invitation string, never store the plain invitation here.
INVITE_SECRET_HASH=
# Integer accounting units, all budgets and the price use the same unit.
VIDEO_COST_UNIT=credits
VIDEO_PRICE_VERSION=
VIDEO_MAX_COST_UNITS=0
VIDEO_DAILY_BUDGET_UNITS=0
VIDEO_TOTAL_BUDGET_UNITS=0
VIDEO_SESSION_BUDGET_UNITS=0
# Exact trusted output hosts from the verified provider, comma-separated.
VIDEO_RESULT_HOSTS=
VIDEO_POLL_MS=5000
